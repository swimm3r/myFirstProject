<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
    <category label="General">
        <setting id="rpi_ip" type="text" label="Server IP Address" default="127.0.0.1"/>
        <setting id="debug_display" type="bool" label="Enable debug information on display" default="false"/>
        <setting id="debug_show_position" type="bool" label="Playback position" default="true" subsetting="true" visible="eq(-1,true)"/>
        <setting id="debug_show_download" type="bool" label="Download speed" default="true" subsetting="true" visible="eq(-2,true)"/>
        <setting id="debug_show_upload" type="bool" label="Upload speed" default="true" subsetting="true" visible="eq(-3,true)"/>
        <setting id="debug_show_peers" type="bool" label="Peers" default="true" subsetting="true" visible="eq(-4,true)"/>
        <setting id="debug_show_ram" type="bool" label="RAM usage" default="true" subsetting="true" visible="eq(-5,true)"/>
        <setting id="debug_show_buffer" type="bool" label="Buffer ahead" default="true" subsetting="true" visible="eq(-6,true)"/>
        <setting id="debug_show_streams" type="bool" label="Active streams" default="true" subsetting="true" visible="eq(-7,true)"/>
        <setting id="debug_show_connections" type="bool" label="Connections" default="true" subsetting="true" visible="eq(-8,true)"/>
        <setting id="debug_show_download_graph" type="bool" label="Download speed graph" default="true" subsetting="true" visible="eq(-9,true)"/>
        <setting id="debug_show_buffer_graph" type="bool" label="RAM buffer graph" default="true" subsetting="true" visible="eq(-10,true)"/>
        <setting id="debug_show_offset" type="bool" label="Playback offset" default="true" subsetting="true" visible="eq(-11,true)"/>
        <setting id="debug_show_idle" type="bool" label="Idle time" default="true" subsetting="true" visible="eq(-12,true)"/>
    </category>
</settings>
