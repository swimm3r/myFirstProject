<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.torrentiotv" name="TorrentioTV" version="2.1.1" provider-name="User">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">P2P RAM Streamer Client via Torrentio</summary>
        <description lang="en">Streams 1080p/720p torrents from local RAM gateway with zero SSD writes.</description>
        <platform>all</platform>
        <assets>
            <icon>resources/icon.png</icon>
        </assets>
    </extension>
</addon>
